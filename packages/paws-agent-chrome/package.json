{
  "name": "@wangjs-jacky/paws-agent-chrome",
  "version": "0.0.1",
  "private": true,
  "description": "Paws Agent floating conversation bubble for Chromium browsers",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:smoke"
  },
  "dependencies": {
    "@wangjs-jacky/paws-agent": "workspace:*",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.27.2",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.11.0"
}
